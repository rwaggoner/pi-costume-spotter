# ---------------------------------------------------------------------------
# Costume Spotter edge configuration.
# Copy to `.env` and edit. Every value here maps to a field in
# costume_spotter/config.py, which documents defaults and validation.
# ---------------------------------------------------------------------------

# dev = laptop: synthetic/webcam camera, mock detector, no hardware needed.
# pi  = Raspberry Pi: Picamera2 + Hailo. (docs/decisions/008-hardware-abstraction.md)
# windows = Windows PC: webcam + ONNX YOLOv8 + speaker. (docs/setup-windows.md;
#           edge\deploy\windows\setup.ps1 writes a ready .env for you)
EDGE_PROFILE=dev

# --- Camera ---------------------------------------------------------------
# Unset = follows the profile (dev -> synthetic, pi -> picamera2, windows -> webcam).
# Set only to override, e.g. webcam demos on a laptop:
#CAMERA_SOURCE=webcam
FRAME_WIDTH=1280
FRAME_HEIGHT=720
TARGET_FPS=15
# Webcam only: which camera (0 = first) and OpenCV backend. auto = DirectShow
# on Windows (fast to open); try msmf if your camera misbehaves.
#CAMERA_INDEX=0
#CAMERA_BACKEND=auto

# --- Detection ------------------------------------------------------------
# Unset = follows the profile (dev -> mock, pi -> hailo, windows -> onnx).
# Override options: hog (laptop person detection, needs [webcam] extra),
# onnx (YOLOv8 via ONNX Runtime, needs [onnx] extra + a model file)
#DETECTOR=hog
DETECTION_CONFIDENCE_THRESHOLD=0.5
# Also greet dogs and cats, in costume or not (onnx and hailo detectors).
DETECT_PETS=true
# Path to the compiled Hailo model — pi profile only (docs/setup-pi.md step 3).
#HAILO_HEF_PATH=/home/pi/costume-spotter-data/models/yolov8s_h8.hef
# ONNX model — export once with edge\deploy\windows\export-model.ps1.
#ONNX_MODEL_PATH=./models/yolov8n.onnx
# cpu, or directml for any DirectX 12 GPU (needs the [directml] extra).
#ONNX_PROVIDER=cpu

# --- Costume identification (Claude Vision) --------------------------------
# Leave unset to run in "pretend" mode: canned costumes, zero cost (03-F7).
#ANTHROPIC_API_KEY=sk-ant-...
# claude-sonnet-5-5: best at specific characters and props (~1 s slower);
# claude-haiku-5-5: fastest and cheapest.
CLAUDE_MODEL=claude-sonnet-5-5
IDENTIFY_TIMEOUT_SECONDS=15

# --- Tracking -------------------------------------------------------------
# Frames a person must be seen before they count as a visitor (02-F3)...
TRACKER_MIN_HITS=3
# ...missed frames tolerated meanwhile (detectors blink on capes and masks)...
TRACKER_MAX_MISSES=2
# ...and seconds out-of-frame before a visitor is forgotten (02-F4).
TRACKER_RETIRE_SECONDS=30

# --- Groups ---------------------------------------------------------------
# People arriving together get ONE Claude call and ONE greeting (02-F7).
# Longest a group waits for friends a step behind (a lone visitor never waits):
GROUP_WAIT_SECONDS=1.0
# Most people per Claude call; bigger crowds are split into several groups:
GROUP_MAX_SIZE=6
# Groups up to this size also hear a short shout-out per costume (04-F9):
SHOUT_OUT_MAX_GROUP=3

# --- Speech ---------------------------------------------------------------
# piper (local, default) | google (needs [gcp] extra + credentials) | null
TTS_ENGINE=null
#PIPER_VOICE_PATH=/home/pi/costume-spotter-data/voices/en_US-lessac-medium.onnx
# ALSA device for playback on the Pi (find yours: `aplay -l`). dev uses files.
#AUDIO_DEVICE=plughw:1,0
# (windows profile: plays on the Windows default output device; AUDIO_DEVICE is ignored)
SPEECH_QUEUE_MAX=3
# Rotate spooky Halloween voice effects, one style per visitor. Built in (no
# extra installs); falls back to normal audio if an effect ever fails.
SPOOKY_VOICE=false

# --- Storage & privacy (docs/requirements/05-storage.md) --------------------
# All runtime data (SQLite DB, snapshots, dev audio output) lives under here.
DATA_DIR=./data
# 0 disables snapshot storage entirely (metadata-only mode, 05-N3).
SNAPSHOT_RETENTION_DAYS=7

# --- API server -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Cloud sync (off by default; docs/setup-gcp.md) -------------------------
CLOUD_SYNC_ENABLED=false
#GCP_PROJECT_ID=my-project
#GCP_PUBSUB_TOPIC=costume-sightings
#GOOGLE_APPLICATION_CREDENTIALS=/path/to/edge-publisher-key.json
DEVICE_ID=porch-pi
